# Test environment only. These values exist solely for the disposable local/CI
# BookStack instance and must never be reused for a real deployment.
# Copy this file to .env before running `docker compose up`.

BOOKSTACK_PORT=6875
BOOKSTACK_URL=http://localhost:6875

# Laravel application key for the throwaway test instance.
BOOKSTACK_APP_KEY=base64:9VAzyWc7F0GOnUmPvu3v/Ei3a616hah3uzVKhtlCPHA=

DB_DATABASE=bookstack
DB_USERNAME=bookstack
DB_PASSWORD=bookstack-test
DB_ROOT_PASSWORD=root-test

# Default administrator account that BookStack creates on first start.
BOOKSTACK_ADMIN_EMAIL=admin@admin.com
BOOKSTACK_ADMIN_PASSWORD=password

# Restricted test users created by the automated test setup.
BOOKSTACK_EDITOR_EMAIL=qa.editor@example.test
BOOKSTACK_EDITOR_PASSWORD=editor-test-pass
BOOKSTACK_VIEWER_EMAIL=qa.viewer@example.test
BOOKSTACK_VIEWER_PASSWORD=viewer-test-pass
